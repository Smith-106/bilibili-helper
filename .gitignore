# maestro / workflow runtime artifacts (session, tmp, receipts, checkpoints, cache)
.workflow/tmp/
.workflow/sessions/
.workflow/recovery/
.workflow/search-cache.json
.workflow/wiki-index.json
.workflow/search-daemon.json
.workflow/spec-analytics.jsonl
.workflow/wiki-index-publisher.lock
# keep curated knowledge in version control:
# .workflow/knowhow/ (wiki/knowhow 条目) + .workflow/kg/maestro.db (知识图谱) 跟踪入库
# 其余 .workflow/* 运行时产物不入库
!.workflow/knowhow/
!.workflow/kg/maestro.db
# sqlite 运行时边车(常驻,不入库) — 必须放在否定规则之后
**/*.db-shm
**/*.db-wal
**/*.db-journal

# Pi agent runtime / injected context (never commit)
.pi/

# Chrome Web Store signing metadata (regenerated per publish)
_metadata/

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Node / build artifacts (project is dependency-free; guard for future tooling)
node_modules/
dist/
build/
out/
*.crx
*.zip
*.pem
*.key

# maestro embedding/vector 索引(可重建,不入库)
.workflow/embedding*
